{
    "geode": "2.0.0",
    "version": "1.0.0",
    "id": "autodecoratorai.reid",
    "name": "Alt3rDECO",
    "developer": "Reid",
    "description": "Alt3rDECO: adaptive procedural decoration assistant for selected Geometry Dash editor objects.",
    "repository": "https://github.com/djdhsvsbdb-design/autodeco",
    "dependencies": [
        {
            "id": "geode",
            "version": ">=2.0.0"
        }
    ],
    "settings": {
        "default-density": {
            "type": "float",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0,
            "name": "Default Decoration Density",
            "description": "Default density for AI decoration generation"
        },
        "default-chaos": {
            "type": "float",
            "default": 0.3,
            "min": 0.0,
            "max": 1.0,
            "name": "Default Chaos Factor",
            "description": "Default randomness for decoration placement"
        }
    },
    "resources": {
        "sprites": [
            "resources/sprites/*.png"
        ]
    }
}
